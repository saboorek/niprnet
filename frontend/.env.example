# Adres API backendu dla danego środowiska.
# Lokalnie:    http://localhost:5000/api
# Staging:     https://staging-lscofd.sbrkcode.pl/api
# Produkcja:   https://lscofd.sbrkcode.pl/api
VITE_API_URL=http://localhost:5000/api

