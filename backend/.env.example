# Środowisko: development | production
NODE_ENV=development
PORT=5000

# Adres frontendu OBSŁUGIWANEGO PRZEZ TO backendowe API.
# Musi być inny dla staging i inny dla produkcji, np.:
#   staging:    https://staging-lscofd.sbrkcode.pl
#   produkcja:  https://lscofd.sbrkcode.pl
FRONTEND_URL=http://localhost:5173

# Osobna baza danych dla każdego środowiska! Nigdy nie współdziel bazy
# między staging i produkcją.
MONGO_URL=mongodb+srv://user:password@cluster0.example.mongodb.net/fireboard_dev

SESSION_SECRET=change-me

# Discord OAuth - w Discord Developer Portal zarejestruj OSOBNY redirect URL
# dla każdego środowiska (staging i produkcja), np.:
#   https://staging-lscofd.sbrkcode.pl/api/auth/discord/callback
#   https://lscofd.sbrkcode.pl/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:5000/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REQUIRED_ROLE_ID=
DISCORD_WEBHOOK_URL=
DISCORD_CHANNEL_ADMIN_LOGS=
DISCORD_CHANNEL_REPORTS=
DISCORD_CHANNEL_CITATIONS=


# Lista ID deweloperów Discord (rozdzielone przecinkiem) z pełnym dostępem.
DEVELOPER_IDS=

